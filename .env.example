# =============================================================================
# HalWall Environment Configuration
# Copy this file to .env and fill in production values.
# NEVER commit .env to version control.
# =============================================================================

# --- Database ---
DATABASE_URL=postgres://halwall_user:CHANGE_ME@pgbouncer:6432/halwall
DATABASE_READ_URL=                          # Optional: read replica URL
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=10000
DB_CIRCUIT_BREAKER_THRESHOLD=5
DB_CIRCUIT_BREAKER_TIMEOUT=30.0
DB_ECHO=false
DB_SSL_REQUIRED=true                        # Set to false for local dev without SSL

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# --- Rate Limiting ---
DEFAULT_RATE_LIMIT=30

# --- Application ---
ENVIRONMENT=production
LOG_LEVEL=WARNING
CORS_ORIGINS=https://your-frontend.example.com

# --- PostgreSQL (used by the DB container) ---
POSTGRES_DB=halwall
POSTGRES_USER=halwall_user
POSTGRES_PASSWORD=CHANGE_ME
